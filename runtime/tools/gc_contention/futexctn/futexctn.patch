+static void print_raw_maps(pid_t pid)
+{
+	char path[64], line[4096];
+	FILE *f;
+
+	snprintf(path, sizeof(path), "/proc/%d/maps", pid);
+	f = fopen(path, "r");
+	if (!f) {
+		fprintf(stderr, "failed to open %s\n", path);
+		return;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		unsigned long start, end, pgoff;
+		char perms[8], file[4096] = "";
+
+		if (sscanf(line, "%lx-%lx %7s %lx %*s %*s %4095s", &start, &end,
+			   perms, &pgoff, file) < 4)
+			continue;
+		if (perms[2] != 'x' || file[0] != '/')
+			continue;
+		printf("FUTEXCTN_MAP\t0x%lx\t0x%lx\t0x%lx\t%s\n", start, end,
+		       pgoff, file);
+	}
+	fclose(f);
+	fflush(stdout);
+}
+
+static void print_raw_entry(struct futexctn_bpf *obj, struct hist_key *key,
+			    struct hist *hist)
+{
+	uint64_t *ip;
+	int i, fd = bpf_map__fd(obj->maps.stackmap);
+
+	printf("FUTEXCTN\t%llu\t%d\t0x%llx\t%llu\t%llu\t%llu\t",
+	       env.merge_threads ? key->pid_tgid : key->pid_tgid >> 32, key->op,
+	       key->uaddr, hist->contended, hist->total_elapsed, hist->max);
+	ip = calloc(env.perf_max_stack_depth, sizeof(*ip));
+	if (ip && !env.summary &&
+	    bpf_map_lookup_elem(fd, &key->user_stack_id, ip) == 0) {
+		for (i = 0; i < env.perf_max_stack_depth && ip[i]; i++)
+			printf("%s0x%lx", i ? "," : "", ip[i]);
+	}
+	printf("\n");
+	free(ip);
+}
